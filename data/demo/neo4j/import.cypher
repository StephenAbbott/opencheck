// BODS Neo4j Import Script
// Generated by bods-neo4j (graph-native schema)
// Run from Neo4j Browser or cypher-shell with CSVs in the import directory.


CREATE CONSTRAINT constraint_entity_record_id IF NOT EXISTS
FOR (e:Entity) REQUIRE e.recordId IS UNIQUE;
CREATE CONSTRAINT constraint_person_record_id IF NOT EXISTS
FOR (p:Person) REQUIRE p.recordId IS UNIQUE;
CREATE CONSTRAINT constraint_identifier_uid IF NOT EXISTS
FOR (i:Identifier) REQUIRE i.uid IS UNIQUE;
CREATE CONSTRAINT constraint_address_uid IF NOT EXISTS
FOR (a:Address) REQUIRE a.uid IS UNIQUE;
CREATE CONSTRAINT constraint_country_code IF NOT EXISTS
FOR (c:Country) REQUIRE c.code IS UNIQUE;
CREATE CONSTRAINT constraint_unspecified_party_uid IF NOT EXISTS
FOR (u:UnspecifiedParty) REQUIRE u.uid IS UNIQUE;


LOAD CSV WITH HEADERS FROM 'file:///country.csv' AS row
CALL {
    WITH row
    MERGE (n:Country {code: row.code})
    SET n.name = row.name
} IN TRANSACTIONS OF 10000 ROWS;


LOAD CSV WITH HEADERS FROM 'file:///identifier.csv' AS row
CALL {
    WITH row
    MERGE (n:Identifier {uid: row.uid})
    SET n.scheme = row.scheme,
        n.id = row.id,
        n.schemeName = row.schemeName,
        n.uri = row.uri
} IN TRANSACTIONS OF 10000 ROWS;


LOAD CSV WITH HEADERS FROM 'file:///address.csv' AS row
CALL {
    WITH row
    MERGE (n:Address {uid: row.uid})
    SET n.address = row.address,
        n.postCode = row.postCode,
        n.defaultType = row.defaultType
} IN TRANSACTIONS OF 10000 ROWS;


LOAD CSV WITH HEADERS FROM 'file:///entity.csv' AS row
CALL {
    WITH row
    MERGE (n:Entity {recordId: row.recordId})
    SET n.statementId = row.statementId,
        n.statementDate = CASE WHEN row.statementDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.statementDate) ELSE row.statementDate END,
        n.recordType = row.recordType,
        n.recordStatus = row.recordStatus,
        n.declarationSubject = row.declarationSubject,
        n.publicationDate = CASE WHEN row.publicationDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.publicationDate) ELSE row.publicationDate END,
        n.bodsVersion = row.bodsVersion,
        n.publisherName = row.publisherName,
        n.publisherUrl = row.publisherUrl,
        n.publicationLicense = row.publicationLicense,
        n.name = row.name,
        n.entityType = row.entityType,
        n.entityTypeDetails = row.entityTypeDetails,
        n.isComponent = toBoolean(row.isComponent),
        n.sourceTypes = row.sourceTypes,
        n.sourceUrl = row.sourceUrl,
        n.extrasJson = row.extrasJson,
        n.foundingDate = CASE WHEN row.foundingDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.foundingDate) ELSE row.foundingDate END,
        n.dissolutionDate = CASE WHEN row.dissolutionDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.dissolutionDate) ELSE row.dissolutionDate END
} IN TRANSACTIONS OF 10000 ROWS;


MATCH (e:Entity) WHERE e.entityType = 'registeredEntity' SET e:RegisteredEntity;
MATCH (e:Entity) WHERE e.entityType = 'legalEntity' SET e:LegalEntity;
MATCH (e:Entity) WHERE e.entityType = 'arrangement' SET e:Arrangement;
MATCH (e:Entity) WHERE e.entityType = 'anonymousEntity' SET e:AnonymousEntity;
MATCH (e:Entity) WHERE e.entityType = 'unknownEntity' SET e:UnknownEntity;
MATCH (e:Entity) WHERE e.entityType = 'state' SET e:State;
MATCH (e:Entity) WHERE e.entityType = 'stateBody' SET e:StateBody;
MATCH (e:Entity) WHERE e.entitySubtype = 'trust' SET e:Trust;
MATCH (e:Entity) WHERE e.entitySubtype = 'nomination' SET e:Nomination;
MATCH (e:Entity) WHERE e.entitySubtype = 'governmentDepartment' SET e:GovernmentDepartment;
MATCH (e:Entity) WHERE e.entitySubtype = 'stateAgency' SET e:StateAgency;


LOAD CSV WITH HEADERS FROM 'file:///person.csv' AS row
CALL {
    WITH row
    MERGE (n:Person {recordId: row.recordId})
    SET n.statementId = row.statementId,
        n.statementDate = CASE WHEN row.statementDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.statementDate) ELSE row.statementDate END,
        n.recordType = row.recordType,
        n.recordStatus = row.recordStatus,
        n.declarationSubject = row.declarationSubject,
        n.publicationDate = CASE WHEN row.publicationDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.publicationDate) ELSE row.publicationDate END,
        n.bodsVersion = row.bodsVersion,
        n.publisherName = row.publisherName,
        n.publisherUrl = row.publisherUrl,
        n.publicationLicense = row.publicationLicense,
        n.personType = row.personType,
        n.isComponent = toBoolean(row.isComponent),
        n.name = row.name,
        n.fullName = row.fullName,
        n.familyName = row.familyName,
        n.givenName = row.givenName,
        n.nameType = row.nameType,
        n.namesJson = row.namesJson,
        n.birthDate = row.birthDate,
        n.nationalityCodes = row.nationalityCodes,
        n.nationalityNames = row.nationalityNames,
        n.sourceTypes = row.sourceTypes,
        n.sourceUrl = row.sourceUrl
} IN TRANSACTIONS OF 10000 ROWS;


LOAD CSV WITH HEADERS FROM 'file:///has_identifier.csv' AS row
CALL {
    WITH row
    OPTIONAL MATCH (e:Entity {recordId: row.start_key})
    OPTIONAL MATCH (p:Person {recordId: row.start_key})
    WITH row, COALESCE(e, p) AS start
    WHERE start IS NOT NULL
    MATCH (id:Identifier {uid: row.end_key})
    MERGE (start)-[r:HAS_IDENTIFIER]->(id)
    SET r.ordinal = toInteger(row.ordinal),
        r.isPrimary = row.isPrimary = 'true'
} IN TRANSACTIONS OF 10000 ROWS;


LOAD CSV WITH HEADERS FROM 'file:///has_address.csv' AS row
CALL {
    WITH row
    OPTIONAL MATCH (e:Entity {recordId: row.start_key})
    OPTIONAL MATCH (p:Person {recordId: row.start_key})
    WITH row, COALESCE(e, p) AS start
    WHERE start IS NOT NULL
    MATCH (a:Address {uid: row.end_key})
    MERGE (start)-[r:HAS_ADDRESS {type: row.type, ordinal: toInteger(row.ordinal)}]->(a)
} IN TRANSACTIONS OF 10000 ROWS;


LOAD CSV WITH HEADERS FROM 'file:///located_in.csv' AS row
CALL {
    WITH row
    MATCH (a:Address {uid: row.start_key})
    MATCH (c:Country {code: row.end_key})
    MERGE (a)-[:LOCATED_IN]->(c)
} IN TRANSACTIONS OF 10000 ROWS;


LOAD CSV WITH HEADERS FROM 'file:///owns.csv' AS row
CALL {
    WITH row
    OPTIONAL MATCH (e_s:Entity {recordId: row.start_key})
    OPTIONAL MATCH (p_s:Person {recordId: row.start_key})
    OPTIONAL MATCH (u_s:UnspecifiedParty {uid: row.start_key})
    WITH row, COALESCE(e_s, p_s, u_s) AS start
    OPTIONAL MATCH (e_t:Entity {recordId: row.end_key})
    OPTIONAL MATCH (p_t:Person {recordId: row.end_key})
    OPTIONAL MATCH (u_t:UnspecifiedParty {uid: row.end_key})
    WITH row, start, COALESCE(e_t, p_t, u_t) AS target
    WHERE start IS NOT NULL AND target IS NOT NULL
    CREATE (start)-[r:OWNS]->(target)
    SET r.statementId = row.statementId,
        r.statementDate = CASE WHEN row.statementDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.statementDate) ELSE row.statementDate END,
        r.recordId = row.recordId,
        r.recordType = row.recordType,
        r.recordStatus = row.recordStatus,
        r.declarationSubject = row.declarationSubject,
        r.publicationDate = CASE WHEN row.publicationDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.publicationDate) ELSE row.publicationDate END,
        r.bodsVersion = row.bodsVersion,
        r.publisherName = row.publisherName,
        r.publisherUrl = row.publisherUrl,
        r.publicationLicense = row.publicationLicense,
        r.isComponent = toBoolean(row.isComponent),
        r.sourceTypes = row.sourceTypes,
        r.sourceUrl = row.sourceUrl,
        r.interestIndex = toInteger(row.interestIndex),
        r.bodsInterestType = row.bodsInterestType,
        r.family = row.family,
        r.directOrIndirect = row.directOrIndirect,
        r.beneficialOwnershipOrControl = toBoolean(row.beneficialOwnershipOrControl),
        r.shareMinimum = toFloat(row.shareMinimum),
        r.shareMaximum = toFloat(row.shareMaximum),
        r.startDate = CASE WHEN row.startDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.startDate) ELSE row.startDate END,
        r.endDate = CASE WHEN row.endDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.endDate) ELSE row.endDate END,
        r.details = row.details,
        r.detailsCategory = row.detailsCategory,
        r.detailsValue = row.detailsValue
} IN TRANSACTIONS OF 10000 ROWS;


LOAD CSV WITH HEADERS FROM 'file:///controls.csv' AS row
CALL {
    WITH row
    OPTIONAL MATCH (e_s:Entity {recordId: row.start_key})
    OPTIONAL MATCH (p_s:Person {recordId: row.start_key})
    OPTIONAL MATCH (u_s:UnspecifiedParty {uid: row.start_key})
    WITH row, COALESCE(e_s, p_s, u_s) AS start
    OPTIONAL MATCH (e_t:Entity {recordId: row.end_key})
    OPTIONAL MATCH (p_t:Person {recordId: row.end_key})
    OPTIONAL MATCH (u_t:UnspecifiedParty {uid: row.end_key})
    WITH row, start, COALESCE(e_t, p_t, u_t) AS target
    WHERE start IS NOT NULL AND target IS NOT NULL
    CREATE (start)-[r:CONTROLS]->(target)
    SET r.statementId = row.statementId,
        r.statementDate = CASE WHEN row.statementDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.statementDate) ELSE row.statementDate END,
        r.recordId = row.recordId,
        r.recordType = row.recordType,
        r.recordStatus = row.recordStatus,
        r.declarationSubject = row.declarationSubject,
        r.publicationDate = CASE WHEN row.publicationDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.publicationDate) ELSE row.publicationDate END,
        r.bodsVersion = row.bodsVersion,
        r.publisherName = row.publisherName,
        r.publisherUrl = row.publisherUrl,
        r.publicationLicense = row.publicationLicense,
        r.isComponent = toBoolean(row.isComponent),
        r.sourceTypes = row.sourceTypes,
        r.sourceUrl = row.sourceUrl,
        r.interestIndex = toInteger(row.interestIndex),
        r.bodsInterestType = row.bodsInterestType,
        r.family = row.family,
        r.directOrIndirect = row.directOrIndirect,
        r.beneficialOwnershipOrControl = toBoolean(row.beneficialOwnershipOrControl),
        r.startDate = CASE WHEN row.startDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.startDate) ELSE row.startDate END,
        r.details = row.details,
        r.detailsCategory = row.detailsCategory,
        r.detailsValue = row.detailsValue,
        r.shareMinimum = toFloat(row.shareMinimum),
        r.shareMaximum = toFloat(row.shareMaximum),
        r.endDate = CASE WHEN row.endDate =~ '\\d{4}-\\d{2}-\\d{2}' THEN date(row.endDate) ELSE row.endDate END
} IN TRANSACTIONS OF 10000 ROWS;


CREATE FULLTEXT INDEX bods_names IF NOT EXISTS
FOR (n:Entity|Person) ON EACH [n.name];


MATCH (e:Entity) WITH count(e) AS entities
MATCH (p:Person) WITH entities, count(p) AS persons
OPTIONAL MATCH ()-[r:OWNS|CONTROLS|MANAGES|IS_PARTY_TO|HAS_OTHER_INTEREST]->()
WITH entities, persons, count(DISTINCT r.statementId) AS relationshipStatements
RETURN entities, persons, relationshipStatements;
