  "successions": [
   {
    "type": "JAGUN",
    "typeAsText": "Division",
    "content": "06.07.2007.a. sõlmitud jagunemislepingu ja 13.08.2007.a. vastu võetud jagunemisotsuse kohaselt jaguneb AS NARVA ELEKTRIJAAMAD, registrikood 10579981, asukoht Auvere küla, Vaivara vald, Ida-Virumaa ( jagunev ühing) eraldumise teel. Omandavaks ühinguks on AS Narva Õlitehas. Jagunemine loetakse toimunuks jaguneva ühingu kaardile jagunemiskande tegemisega.",
    "cardNumber": 1,
    "cardType": "R",
    "entryNumber": 3,
    "recordId": 3536431,
    "startDate": "2007-09-24",
    "endDate": "2017-01-10"
   },
   {
    "type": "JAGUN",
    "typeAsText": "Division",
    "content": "24.09.2007.a. on tehtud konstitutiivne jagunemiskanne AS NARVA ELEKTRIJAAMAD, registrikood 10579981, Auvere küla, Vaivara vald, Ida-Virumaa, registrikaardile.",
