# OpenCheck — environment variables.
# Copy this file to `.env` and fill in real values as you progress through phases.
# Phase 0 stubs run without any API keys.

# ---------------- Phase 0+ ----------------

# Optional. When true, live source adapters are allowed to make real HTTP calls.
# When false (default in Phase 0), all adapters return stub responses.
OPENCHECK_ALLOW_LIVE=false

# CORS origin for the frontend dev server.
OPENCHECK_CORS_ORIGIN=http://localhost:5173

# ---------------- Phase 1 — first live adapter ----------------

# UK Companies House API key.
# Get one at https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Dedicated Companies House key for the Time Machine /history endpoint
# (filing-history fetch). Kept separate from the lookup key above; falls back
# to COMPANIES_HOUSE_API_KEY if left blank.
COMPANIES_HOUSE_HISTORY_API_KEY=

# New Zealand NZBN API subscription key (Companies Office / MBIE — free).
# Subscribe at https://portal.api.business.govt.nz/ (NZBN product).
NZBN_API_KEY=

# New Zealand Companies Entity Role Search API — SEPARATE subscription key.
# Powers the lazy /nz-associations enrichment (director/shareholder links across
# the register). Subscribe to the "Companies Entity Role Search" product.
NZBN_ROLE_SEARCH_API_KEY=

# ---------------- Phase 2 — remaining entity sources ----------------

# GLEIF is a public, unauthenticated API — no key needed.

# OpenSanctions API key (free tier is sufficient for the hosted demo).
# Register at https://www.opensanctions.org/account/
OPENSANCTIONS_API_KEY=

# OpenAleph API key (required for some collections, not all).
# Instance: https://search.openaleph.org/
OPENALEPH_API_KEY=
WIKIRATE_API_KEY=

# OpenCorporates API key.
# Entry point is the ``ocid`` field returned by GLEIF Level 1 API
# (attributes.ocid), in jurisdiction/company_number format.
# Register at https://opencorporates.com/api_account/new
OPENCORPORATES_API_KEY=

# ---------------- Phase 3 — person sources ----------------

# EveryPolitician is served via OpenSanctions' PEPs dataset — reuses OPENSANCTIONS_API_KEY.

# Wikidata public SPARQL endpoint — no key required; respect WDQS rate limits.
# Override if using a private mirror or QLever endpoint.
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql

# ---------------- Optional — LLM for intent extraction and phrasing ----------------

# Anthropic API key (for intent extraction, disambiguation, and narrative phrasing).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---------------- AMLA risk-rule tuning ----------------

# The NON_EU_JURISDICTION risk signal flags any BODS jurisdiction outside
# the EU+EEA. The default set is the 27 EU member states plus IS, LI, NO.
#
# Comma-separated ISO 3166-1 alpha-2 codes ADDED to the default set.
# Use this to suppress NON_EU_JURISDICTION for jurisdictions you regard
# as AML-equivalent — e.g. GB for the UK Companies House anchor, or CH.
OPENCHECK_AMLA_EQUIVALENT_JURISDICTIONS=

# When set, REPLACES the entire EU+EEA default set. Use only when you
# want strict AMLA EU-only (drop EEA) or a fully custom basis.
OPENCHECK_AMLA_EU_EEA_OVERRIDE=

# ---------------- Phase 88 — SEO entity pages ----------------

# Local path of the GLEIF-derived SQLite behind /entity, /sitemaps and /browse.
# Build it with:  cd backend && uv run python scripts/build_entity_pages_db.py \
#                   --out data/entity_pages.sqlite
# (add --sample 50000 for a quick dev subset; --delta LastMonth for the
# monthly refresh). When neither var is set those routes answer 503.
OPENCHECK_ENTITY_PAGES_DB_FILE=

# Alternative for ephemeral-disk hosts (Render): URL of a prebuilt
# entity_pages.sqlite or .sqlite.gz, downloaded at boot.
OPENCHECK_ENTITY_PAGES_DB_URL=

# Single-service mode: serve the built SPA (frontend/dist) from the backend so
# opencheck.world can serve the entity pages from one origin. In the Docker
# image the baked-in copy lives at /app/frontend_dist. Leave unset for the
# split static-site + API deploy.
OPENCHECK_FRONTEND_DIST=

# ---------------- Phase 89 — privacy-respecting analytics ----------------

# GoatCounter endpoint used by the server-rendered /entity and /browse pages.
# Cookie-less; only fixed path buckets are recorded, never LEIs or query
# strings. Defaults to https://opencheck.goatcounter.com/count; set to an
# empty string to disable. (The SPA's copy of the endpoint is baked into
# frontend/src/lib/analytics.ts.)
OPENCHECK_GOATCOUNTER_ENDPOINT=

# ---------------- Phase 91 — IndexNow (SEO Phase D) ----------------

# Shared IndexNow key. Served back at /indexnow/{key}.txt so engines can
# verify the host; the monthly refresh workflow submits changed entity URLs
# with the matching INDEXNOW_KEY GitHub Actions secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
OPENCHECK_INDEXNOW_KEY=

# ---------------- Memory + traffic instrumentation (memwatch) ----------------

# Interval in seconds between "memwatch" memory-report log lines (RSS vs the
# container limit, cache sizes, per-path request counts, bot share). Added
# after the 2026-08-05/06 Render OOM restarts. 0 disables the reporter.
OPENCHECK_MEMWATCH_INTERVAL=30

# RSS as % of the container memory limit at which the memwatch line escalates
# to WARNING.
OPENCHECK_MEMWATCH_WARN_PCT=85

# Opt-in tracemalloc tracing: on high water, also log the top Python
# allocation sites. Costs memory — enable only while hunting a leak.
OPENCHECK_MEMWATCH_TRACEMALLOC=false

# Per-request access-log lines with User-Agent + bot flag (uvicorn's own
# access log has no UA, so crawler traffic is otherwise invisible).
OPENCHECK_ACCESS_LOG=true

# Override the memory limit (MB) used for the pct calculation; unset = read
# from cgroups, which is correct on Render/Docker.
OPENCHECK_MEMORY_LIMIT_MB=
